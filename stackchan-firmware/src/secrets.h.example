// Copia este archivo a "secrets.h" (en la misma carpeta) y completa tus datos.
// "secrets.h" está en .gitignore — nunca subas el archivo real con tus credenciales.
#pragma once

#define WIFI_SSID "tu-red-wifi"
#define WIFI_PASSWORD "tu-password-wifi"

// URL de la Cloud Function deviceCommand. La ves en la consola de Firebase después
// de desplegarla, o en la salida de "firebase deploy --only functions" — algo como:
// https://us-central1-TU-PROYECTO.cloudfunctions.net/deviceCommand
#define GABY_ENDPOINT "https://REGION-TU-PROYECTO.cloudfunctions.net/deviceCommand"

// El mismo valor que configuraste con:
//   firebase functions:secrets:set DEVICE_SHARED_SECRET
#define DEVICE_SHARED_SECRET "elige-un-secreto-largo-y-aleatorio"

// El id del workspace de Firestore al que este robot pertenece (lo ves en la app,
// o en Firestore -> colección "workspaces" -> el id del documento).
#define GABY_WORKSPACE_ID "tu-workspace-id"
