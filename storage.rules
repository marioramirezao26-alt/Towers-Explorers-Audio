rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isMember(workspaceId) {
      return request.auth != null &&
        request.auth.uid in firestore.get(/databases/(default)/documents/workspaces/$(workspaceId)).data.memberIds;
    }

    match /workspaces/{workspaceId}/voiceNotes/{fileName} {
      allow read, write: if isMember(workspaceId);
    }
  }
}
