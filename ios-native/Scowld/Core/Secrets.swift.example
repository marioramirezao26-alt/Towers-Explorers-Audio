import Foundation

// Copia este archivo a "Secrets.swift" (mismo directorio) y completa tus datos.
// "Secrets.swift" está en .gitignore — nunca subas el archivo real con datos
// reales a git. Mismo patrón que stackchan-firmware/src/secrets.h.example.
enum GabySecrets {
    /// La URL que te muestra la terminal al desplegar deviceCommand, algo como:
    /// https://REGION-TU-PROYECTO.cloudfunctions.net/deviceCommand
    static let deviceCommandEndpoint = ""

    /// El mismo valor que configuraste con:
    ///   firebase functions:secrets:set DEVICE_SHARED_SECRET
    static let deviceSharedSecret = ""

    /// El id de tu workspace en Firestore (lo ves en la app, o en la consola de
    /// Firebase → Firestore → colección "workspaces" → el id del documento).
    static let workspaceId = ""
}
