# Copia este archivo a ".env" y completa con tus propias credenciales.
# Nunca subas el archivo ".env" real al repositorio.

# --- Firebase (Configuración del proyecto > Configuración general > Tus apps) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ---
# Necesitas un Client ID por plataforma para el login de Google Calendar.
# webClientId también sirve para probar dentro de la app Expo Go.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
